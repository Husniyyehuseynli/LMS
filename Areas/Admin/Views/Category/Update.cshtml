@model LMS.Areas.Admin.ViewModels.Category.UpdateCategoryVM
@{
    ViewData["Title"] = "Edit Category";
}

<div class="card stat-card p-4" style="max-width:500px;">
    <form asp-area="Admin" asp-controller="Category" asp-action="Update" method="post">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label">Category Name</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Icon" class="form-label">Icon</label>
            <select asp-for="Icon" class="form-select" asp-items="Html.GetEnumSelectList<LMS.Models.CategoryIcon>()"></select>
            <span asp-validation-for="Icon" class="text-danger small"></span>
        </div>

        <button type="submit" class="btn btn-primary"><i class="fa fa-save me-2"></i>Update</button>
        <a asp-area="Admin" asp-controller="Category" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>
