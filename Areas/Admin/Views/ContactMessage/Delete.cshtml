@model LMS.Models.ContactMessage
@{
    ViewData["Title"] = "Delete Contact Message";
}

<h4 class="mb-4">Delete Contact Message</h4>

<div class="card stat-card p-4" style="max-width:600px;">
    <p>Are you sure you want to delete this message?</p>

    <dl class="row mb-4">
        <dt class="col-sm-3">Name</dt>
        <dd class="col-sm-9">@Model.Name</dd>
        <dt class="col-sm-3">Email</dt>
        <dd class="col-sm-9">@Model.Email</dd>
        <dt class="col-sm-3">Subject</dt>
        <dd class="col-sm-9">@Model.Subject</dd>
        <dt class="col-sm-3">Message</dt>
        <dd class="col-sm-9" style="white-space:pre-wrap;">@Model.Message</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
