@model Quiz
@{
    ViewData["Title"] = "Questions - " + Model.Title;
    var questions = Model.Questions?.Where(q => !q.IsDeleted).ToList() ?? new List<Question>();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h5 class="mb-0">@Model.Title - Questions</h5>
        <span class="text-muted small">@Model.Course?.Name</span>
    </div>
    <div>
        <a asp-area="Admin" asp-controller="Question" asp-action="Create" asp-route-quizId="@Model.Id" class="btn btn-primary"><i class="fa fa-plus me-2"></i>New Question</a>
        <a asp-area="Admin" asp-controller="Quiz" asp-action="Index" class="btn btn-outline-secondary">Back</a>
    </div>
</div>

@if (!questions.Any())
{
    <div class="alert alert-light border">No questions have been added for this quiz yet.</div>
}
else
{
    <div class="card stat-card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Question</th>
                        <th>A</th>
                        <th>B</th>
                        <th>C</th>
                        <th>D</th>
                        <th>Correct</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < questions.Count; i++)
                    {
                        var q = questions[i];
                        <tr>
                            <td>@(i + 1)</td>
                            <td>@q.Text</td>
                            <td class="@(q.CorrectOption == "A" ? "fw-bold text-success" : "")">@q.OptionA</td>
                            <td class="@(q.CorrectOption == "B" ? "fw-bold text-success" : "")">@q.OptionB</td>
                            <td class="@(q.CorrectOption == "C" ? "fw-bold text-success" : "")">@q.OptionC</td>
                            <td class="@(q.CorrectOption == "D" ? "fw-bold text-success" : "")">@q.OptionD</td>
                            <td><span class="badge bg-success">@q.CorrectOption</span></td>
                            <td class="text-end">
                                <a asp-area="Admin" asp-controller="Question" asp-action="Update" asp-route-id="@q.Id" class="btn btn-sm btn-outline-primary"><i class="fa fa-edit"></i></a>
                                <form asp-area="Admin" asp-controller="Question" asp-action="Delete" asp-route-id="@q.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fa fa-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
