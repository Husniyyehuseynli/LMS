@using Microsoft.AspNetCore.Identity
@using LMS.DAL
@using Microsoft.EntityFrameworkCore
@inject UserManager<AppUser> UserManager
@inject AppDbContext Db
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Admin Panel | LMS</title>

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">
    <link href="~/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #f4f6f9; font-family: 'Nunito', sans-serif; }
        #adminSidebar {
            width: 250px; min-height: 100vh; background: linear-gradient(180deg,#2b3ab2,#1f2a80);
            position: fixed; top: 0; left: 0; z-index: 1000;
        }
        #adminSidebar .brand { color: #fff; font-weight: 800; font-size: 1.3rem; padding: 1.3rem 1.2rem; display: block; text-decoration: none; }
        #adminSidebar .nav-link { color: rgba(255,255,255,.8); padding: .75rem 1.2rem; border-left: 3px solid transparent; }
        #adminSidebar .nav-link:hover, #adminSidebar .nav-link.active { color: #fff; background: rgba(255,255,255,.08); border-left-color: #fff; }
        #adminContent { margin-left: 250px; min-height: 100vh; }
        .admin-topbar { background: #fff; box-shadow: 0 1px 4px rgba(0,0,0,.08); padding: .8rem 1.5rem; }
        .stat-card { border-radius: .6rem; border: none; box-shadow: 0 1px 4px rgba(0,0,0,.08); }
        @@media (max-width: 768px) {
            #adminSidebar { width: 0; overflow: hidden; }
            #adminContent { margin-left: 0; }
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <div id="adminSidebar">
        <a class="brand" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
            <i class="fa fa-book me-2"></i>LMS Admin
        </a>
        <hr class="border-light opacity-25 mx-3" />
        <ul class="nav flex-column">
            <li class="nav-item">
                <a class="nav-link" asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><i class="fa fa-tachometer-alt me-2"></i>Dashboard</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-area="Admin" asp-controller="Category" asp-action="Index"><i class="fa fa-layer-group me-2"></i>Categories</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-area="Admin" asp-controller="Course" asp-action="Index"><i class="fa fa-graduation-cap me-2"></i>Courses</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-area="Admin" asp-controller="Quiz" asp-action="Index"><i class="fa fa-question-circle me-2"></i>Quizzes</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-area="Admin" asp-controller="Teacher" asp-action="Index"><i class="fa fa-user-tie me-2"></i>Teachers</a>
            </li>
            <li class="nav-item">
                <a class="nav-link d-flex justify-content-between align-items-center" asp-area="Admin" asp-controller="TeacherApplication" asp-action="Index">
                    <span><i class="fa fa-chalkboard-teacher me-2"></i>Teacher Applications</span>
                    @{
                        int pendingAppCount = await Db.TeacherApplications.CountAsync(a => !a.IsDeleted && a.Status == LMS.Models.ApplicationStatus.Pending);
                    }
                    @if (pendingAppCount > 0)
                    {
                        <span class="badge bg-warning text-dark rounded-pill">@pendingAppCount</span>
                    }
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-area="Admin" asp-controller="Reports" asp-action="Index"><i class="fa fa-chart-line me-2"></i>Reports</a>
            </li>
            <li class="nav-item">
                <a class="nav-link d-flex justify-content-between align-items-center" asp-area="Admin" asp-controller="ContactMessage" asp-action="Index">
                    <span><i class="fa fa-envelope me-2"></i>Contact Messages</span>
                    @{
                        int unreadCount = await Db.ContactMessages.CountAsync(m => !m.IsDeleted && !m.IsRead);
                    }
                    @if (unreadCount > 0)
                    {
                        <span class="badge bg-danger rounded-pill">@unreadCount</span>
                    }
                </a>
            </li>
        </ul>
        <hr class="border-light opacity-25 mx-3" />
        <ul class="nav flex-column">
            <li class="nav-item">
                <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index"><i class="fa fa-globe me-2"></i>Back to Site</a>
            </li>
            <li class="nav-item">
                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="nav-link border-0 bg-transparent w-100 text-start"><i class="fa fa-sign-out-alt me-2"></i>Logout</button>
                </form>
            </li>
        </ul>
    </div>

    <div id="adminContent">
        <div class="admin-topbar d-flex justify-content-between align-items-center">
            <h5 class="mb-0">@ViewData["Title"]</h5>
            <span class="text-muted"><i class="fa fa-user-circle me-2"></i>@{
                AppUser? adminNavUser = await UserManager.GetUserAsync(User);
            }@(adminNavUser != null ? $"{adminNavUser.Name} {adminNavUser.Surname}" : UserManager.GetUserName(User))</span>
        </div>

        <div class="p-4">
            @RenderBody()
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
