@model Course
@{
    ViewData["Title"] = "Lessons - " + Model.Name;
    var lessons = Model.Lessons?.Where(l => !l.IsDeleted).OrderBy(l => l.OrderIndex).ToList() ?? new List<Lesson>();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h5 class="mb-0">@Model.Name - Lessons</h5>
        <span class="text-muted small">@lessons.Count lesson(s)</span>
    </div>
    <div>
        <a asp-area="Admin" asp-controller="Lesson" asp-action="Create" asp-route-courseId="@Model.Id" class="btn btn-primary"><i class="fa fa-plus me-2"></i>New Lesson</a>
        <a asp-area="Admin" asp-controller="Course" asp-action="Progress" asp-route-id="@Model.Id" class="btn btn-outline-success"><i class="fa fa-chart-line me-2"></i>Progress</a>
        <a asp-area="Admin" asp-controller="Course" asp-action="Index" class="btn btn-outline-secondary">Back</a>
    </div>
</div>

@if (!lessons.Any())
{
    <div class="alert alert-light border">No lessons have been added for this course yet.</div>
}
else
{
    <div class="card stat-card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Title</th>
                        <th>Has Video</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var lesson in lessons)
                    {
                        <tr>
                            <td>@lesson.OrderIndex</td>
                            <td>@lesson.Title</td>
                            <td>
                                @if (!string.IsNullOrEmpty(lesson.VideoUrl))
                                {
                                    <span class="badge bg-success">Yes</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">No</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-area="Admin" asp-controller="Lesson" asp-action="Update" asp-route-id="@lesson.Id" class="btn btn-sm btn-outline-primary"><i class="fa fa-edit"></i></a>
                                <form asp-area="Admin" asp-controller="Lesson" asp-action="Delete" asp-route-id="@lesson.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fa fa-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
