@{
    ViewData["Title"] = "Dashboard";
}

<div class="row g-4 mb-4">
    <div class="col-md-6 col-xl-3">
        <div class="card stat-card p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small">Courses</div>
                    <h3 class="mb-0">@ViewBag.CourseCount</h3>
                </div>
                <i class="fa fa-graduation-cap fa-2x text-primary"></i>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card stat-card p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small">Categories</div>
                    <h3 class="mb-0">@ViewBag.CategoryCount</h3>
                </div>
                <i class="fa fa-layer-group fa-2x text-success"></i>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card stat-card p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small">Quizzes</div>
                    <h3 class="mb-0">@ViewBag.QuizCount</h3>
                </div>
                <i class="fa fa-question-circle fa-2x text-warning"></i>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card stat-card p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small">Students</div>
                    <h3 class="mb-0">@ViewBag.StudentCount</h3>
                </div>
                <i class="fa fa-users fa-2x text-info"></i>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card stat-card p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small">Avg. Lesson Completion</div>
                    <h3 class="mb-0">@ViewBag.AvgLessonCompletion%</h3>
                </div>
                <i class="fa fa-tasks fa-2x text-success"></i>
            </div>
        </div>
    </div>
</div>

<div class="card stat-card p-4">
    <h5 class="mb-3">Welcome</h5>
    <p class="text-muted mb-0">Use the menu on the left to manage categories, courses, and quizzes. Total enrollments: <strong>@ViewBag.EnrollmentCount</strong></p>
</div>
