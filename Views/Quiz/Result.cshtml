@model QuizResult
@{
    ViewData["Title"] = "Quiz Result";
    double percent = Model.TotalCount > 0 ? Math.Round((double)Model.CorrectCount / Model.TotalCount * 100, 1) : 0;
    bool passed = percent >= 60;
}

<div class="container-fluid bg-primary py-5 mb-5 page-header">
    <div class="container py-5">
        <h1 class="display-4 text-white text-center mb-0">Quiz Result</h1>
    </div>
</div>

<div class="container-xxl py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <div class="bg-light rounded p-5 text-center shadow-sm">
                    <i class="fa @(passed ? "fa-check-circle text-success" : "fa-times-circle text-danger") fa-5x mb-4"></i>
                    <h3 class="mb-2">@Model.Quiz?.Title</h3>
                    <p class="text-muted mb-4">@Model.Quiz?.Course?.Name</p>

                    <h1 class="display-4 mb-2">@Model.CorrectCount / @Model.TotalCount</h1>
                    <span class="badge @(passed ? "bg-success" : "bg-danger") fs-6 mb-4">@percent%</span>

                    <p class="mb-4">
                        @if (passed)
                        {
                            <span>Congratulations! You passed the quiz.</span>
                        }
                        else
                        {
                            <span>Unfortunately, you did not reach the passing score. You can review the material and try again.</span>
                        }
                    </p>

                    <div class="d-flex gap-2 justify-content-center">
                        <a asp-controller="Quiz" asp-action="Take" asp-route-id="@Model.QuizId" class="btn btn-outline-primary">Try Again</a>
                        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary">Back to My Courses</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
