@{
    Layout = null;
    var course = (LMS.Models.Course)ViewBag.Course;
    string studentName = ViewBag.StudentName;
    DateTime issueDate = ViewBag.IssueDate;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Certificate - @course.Name</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">
    <style>
        * { box-sizing: border-box; }
        body {
            font-family: 'Poppins', sans-serif;
            background: #eef2f7;
            margin: 0;
            padding: 40px 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        .certificate {
            width: 100%;
            max-width: 950px;
            background: #ffffff;
            border: 14px solid #0d2c54;
            outline: 3px solid #d4af37;
            outline-offset: -24px;
            padding: 70px 60px;
            position: relative;
            box-shadow: 0 20px 60px rgba(0,0,0,0.15);
        }
        .corner {
            position: absolute;
            width: 46px;
            height: 46px;
            border: 3px solid #d4af37;
        }
        .corner.tl { top: 14px; left: 14px; border-right: none; border-bottom: none; }
        .corner.tr { top: 14px; right: 14px; border-left: none; border-bottom: none; }
        .corner.bl { bottom: 14px; left: 14px; border-right: none; border-top: none; }
        .corner.br { bottom: 14px; right: 14px; border-left: none; border-top: none; }
        .brand {
            text-align: center;
            color: #0d2c54;
            font-weight: 600;
            letter-spacing: 4px;
            font-size: 14px;
            margin-bottom: 6px;
        }
        h1.title {
            font-family: 'Playfair Display', serif;
            text-align: center;
            font-size: 46px;
            color: #0d2c54;
            margin: 0 0 6px;
        }
        .subtitle {
            text-align: center;
            color: #888;
            font-size: 15px;
            letter-spacing: 2px;
            text-transform: uppercase;
            margin-bottom: 40px;
        }
        .presented {
            text-align: center;
            color: #555;
            font-size: 16px;
        }
        .student-name {
            font-family: 'Playfair Display', serif;
            text-align: center;
            font-size: 40px;
            color: #d4af37;
            margin: 14px 0 22px;
            border-bottom: 2px solid #e5e5e5;
            padding-bottom: 18px;
        }
        .description {
            text-align: center;
            color: #555;
            font-size: 16px;
            line-height: 1.7;
            max-width: 650px;
            margin: 0 auto 40px;
        }
        .course-name {
            font-weight: 600;
            color: #0d2c54;
        }
        .footer-row {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-top: 50px;
        }
        .footer-col {
            text-align: center;
            width: 240px;
        }
        .footer-col .line {
            border-top: 2px solid #0d2c54;
            margin-bottom: 8px;
        }
        .footer-col .label {
            color: #888;
            font-size: 13px;
            letter-spacing: 1px;
        }
        .footer-col .value {
            font-weight: 600;
            color: #0d2c54;
            font-size: 15px;
        }
        .seal {
            width: 90px;
            height: 90px;
            border-radius: 50%;
            border: 3px solid #d4af37;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #d4af37;
            font-family: 'Playfair Display', serif;
            font-size: 13px;
            text-align: center;
            line-height: 1.2;
            margin: 0 auto 8px;
        }
        .actions {
            margin-top: 30px;
            text-align: center;
        }
        .actions button, .actions a {
            display: inline-block;
            padding: 12px 28px;
            border-radius: 6px;
            border: none;
            background: #0d2c54;
            color: #fff;
            font-size: 15px;
            cursor: pointer;
            text-decoration: none;
            margin: 0 6px;
        }
        .actions a.secondary {
            background: transparent;
            color: #0d2c54;
            border: 2px solid #0d2c54;
        }
        @@media print {
            body { background: #fff; padding: 0; }
            .actions { display: none; }
            .certificate { box-shadow: none; border-width: 10px; }
        }
    </style>
</head>
<body>
    <div class="certificate">
        <div class="corner tl"></div>
        <div class="corner tr"></div>
        <div class="corner bl"></div>
        <div class="corner br"></div>

        <div class="brand">L M S &nbsp;•&nbsp; LEARNING MANAGEMENT SYSTEM</div>
        <h1 class="title">Certificate of Completion</h1>
        <div class="subtitle">This certificate is proudly presented to</div>

        <div class="student-name">@studentName</div>

        <div class="description">
            for successfully completing the course
            <div class="course-name">"@course.Name"</div>
            demonstrating dedication and achieving a passing score on all course quizzes.
        </div>

        <div class="footer-row">
            <div class="footer-col">
                <div class="line"></div>
                <div class="value">@issueDate.ToString("dd MMMM yyyy")</div>
                <div class="label">DATE ISSUED</div>
            </div>
            <div class="footer-col">
                <div class="seal">LMS<br />OFFICIAL</div>
                <div class="label">VERIFIED</div>
            </div>
            <div class="footer-col">
                <div class="line"></div>
                <div class="value">@course.InstructorName</div>
                <div class="label">COURSE INSTRUCTOR</div>
            </div>
        </div>
    </div>

    <div class="actions">
        <button onclick="window.print()">Print / Save as PDF</button>
        <a class="secondary" href="/Dashboard">Back to Dashboard</a>
    </div>
</body>
</html>
