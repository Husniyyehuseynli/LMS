@model Course
@{
    ViewData["Title"] = Model.Name;
    bool isEnrolled = ViewBag.IsEnrolled;
    bool hasReviewed = ViewBag.HasReviewed;
    double avgRating = ViewBag.AverageRating;
    int reviewCount = ViewBag.ReviewCount;
    List<Review> reviews = ViewBag.Reviews;
    int studentCount = ViewBag.StudentCount;
    Dictionary<int, int> ratingDistribution = ViewBag.RatingDistribution;
    List<Course> relatedCourses = ViewBag.RelatedCourses;

    var activeLessons = Model.Lessons?.Where(l => !l.IsDeleted).OrderBy(l => l.OrderIndex).ToList() ?? new List<Lesson>();
    var activeQuizzes = Model.Quizzes?.Where(q => !q.IsDeleted).ToList() ?? new List<Quiz>();
    var whatYoullLearn = Model.GetWhatYoullLearn();
    var requirements = Model.GetRequirements();
    Dictionary<int, bool> lessonProgress = ViewBag.LessonProgress ?? new Dictionary<int, bool>();
    int progressPercent = ViewBag.ProgressPercent;
}

<div class="container-fluid bg-primary py-5 mb-5 page-header">
    <div class="container py-5">
        <div class="mb-2">
            <span class="badge bg-white text-primary">@Model.Category?.Name</span>
        </div>
        <h1 class="display-5 text-white mb-3">@Model.Name</h1>
        <p class="text-white-50 mb-3" style="max-width:700px;">@Model.ShortDescription</p>

        <div class="d-flex flex-wrap align-items-center gap-3 text-white">
            <span>
                @for (int i = 1; i <= 5; i++)
                {
                    <i class="fa fa-star @(i <= Math.Round(avgRating) ? "text-warning" : "text-white-50")"></i>
                }
                <span class="ms-1">@avgRating.ToString("0.0") (@reviewCount review@(reviewCount == 1 ? "" : "s"))</span>
            </span>
            <span><i class="fa fa-user-graduate me-1"></i>@studentCount students</span>
            <span><i class="fa fa-signal me-1"></i>@Model.Level</span>
            <span><i class="fa fa-globe me-1"></i>@Model.Language</span>
            <span><i class="fa fa-clock me-1"></i>@Model.DurationHours hours</span>
            @if (Model.Teacher != null)
            {
                <span><i class="fa fa-user-tie me-1"></i>@Model.Teacher.FullName</span>
            }
            else
            {
                <span><i class="fa fa-user-tie me-1"></i>@Model.InstructorName</span>
            }
        </div>
    </div>
</div>

<div class="container-xxl py-5">
    <div class="container">
        @if (TempData["CertificateError"] != null)
        {
            <div class="alert alert-warning">@TempData["CertificateError"]</div>
        }
        <div class="row g-5">
            <div class="col-lg-8">
                <!-- Nav Tabs -->
                <ul class="nav nav-tabs mb-4" id="courseDetailsTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-overview" type="button" role="tab">Overview</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-curriculum" type="button" role="tab">Curriculum</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-reviews" type="button" role="tab">Reviews (@reviewCount)</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-instructor" type="button" role="tab">Instructor</button>
                    </li>
                </ul>

                <div class="tab-content">
                    <!-- ===== Overview ===== -->
                    <div class="tab-pane fade show active" id="tab-overview" role="tabpanel">
                        @if (!string.IsNullOrEmpty(Model.VideoUrl))
                        {
                            <h4 class="mb-3"><i class="fa fa-play-circle text-primary me-2"></i>Course Preview</h4>
                            <div class="ratio ratio-16x9 mb-4">
                                <iframe src="@Model.VideoUrl" title="@Model.Name preview" allowfullscreen></iframe>
                            </div>
                        }
                        else
                        {
                            <img class="img-fluid rounded mb-4 w-100" style="max-height:400px;object-fit:cover;" src="@(string.IsNullOrEmpty(Model.ImageUrl) ? Url.Content($"~/img/course-{(Model.Id % 3) + 1}.jpg") : Url.Content("~/uploads/courses/" + Model.ImageUrl))" alt="@Model.Name" onerror="this.onerror=null;this.src='@Url.Content("~/img/course-3.jpg")'">
                        }

                        <h4 class="mb-3">About the Course</h4>
                        <p>@Model.Description</p>

                        <h5 class="mt-4 mb-3"><i class="fa fa-check-circle text-success me-2"></i>What You'll Learn</h5>
                        <div class="row g-2 mb-4">
                            @foreach (var point in whatYoullLearn)
                            {
                                <div class="col-md-6">
                                    <div class="d-flex">
                                        <i class="fa fa-check text-success me-2 mt-1"></i>
                                        <span>@point.</span>
                                    </div>
                                </div>
                            }
                        </div>

                        <h5 class="mt-4 mb-3"><i class="fa fa-list-check text-primary me-2"></i>Requirements</h5>
                        <ul>
                            @foreach (var req in requirements)
                            {
                                <li>@req</li>
                            }
                        </ul>
                    </div>

                    <!-- ===== Curriculum ===== -->
                    <div class="tab-pane fade" id="tab-curriculum" role="tabpanel">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="mb-0">Course Curriculum</h5>
                            <span class="text-muted small">@activeLessons.Count lesson@(activeLessons.Count == 1 ? "" : "s")</span>
                        </div>

                        @if (activeLessons.Any())
                        {
                            @if (isEnrolled)
                            {
                                <div class="mb-3">
                                    <div class="d-flex justify-content-between small text-muted mb-1">
                                        <span>Your progress</span>
                                        <span id="lessonProgressText">@progressPercent% complete</span>
                                    </div>
                                    <div class="progress" style="height:8px;">
                                        <div class="progress-bar bg-success" id="lessonProgressBar" role="progressbar"
                                             style="width:@(progressPercent)%;" aria-valuenow="@progressPercent" aria-valuemin="0" aria-valuemax="100"></div>
                                    </div>
                                </div>
                            }
                            <div class="d-flex flex-column gap-2 mb-4">
                                @foreach (var lesson in activeLessons)
                                {
                                    bool isCompleted = lessonProgress.TryGetValue(lesson.Id, out bool done) && done;
                                    <div class="curriculum-item p-3 d-flex align-items-center justify-content-between @(isCompleted ? "curriculum-item-completed" : "")" data-lesson-row="@lesson.Id">
                                        <div class="d-flex align-items-center">
                                            @if (isEnrolled)
                                            {
                                                <button type="button" class="btn btn-link p-0 me-3 lesson-progress-toggle" data-lesson-id="@lesson.Id"
                                                        title="@(isCompleted ? "Mark as not started" : "Mark as completed")">
                                                    <i class="fa @(isCompleted ? "fa-check-circle text-success" : "fa-circle text-muted") fs-5 lesson-status-icon"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <i class="fa fa-circle text-muted me-3" title="Enroll to track your progress"></i>
                                            }
                                            <div>
                                                <span class="text-muted small me-2">@lesson.OrderIndex.</span>
                                                <strong>@lesson.Title</strong>
                                            </div>
                                        </div>
                                        @if (!string.IsNullOrEmpty(lesson.VideoUrl))
                                        {
                                            <i class="fa fa-circle-play text-primary"></i>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-muted">No lessons have been added for this course yet.</p>
                        }

                        <h5 class="mt-4 mb-3"><i class="fa fa-question-circle text-primary me-2"></i>Quizzes</h5>
                        @if (activeQuizzes.Any())
                        {
                            <ul class="list-group">
                                @foreach (var quiz in activeQuizzes)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <div>
                                            <strong>@quiz.Title</strong>
                                            @if (!string.IsNullOrEmpty(quiz.Description))
                                            {
                                                <div class="text-muted small">@quiz.Description</div>
                                            }
                                        </div>
                                        @if (isEnrolled)
                                        {
                                            <a asp-controller="Quiz" asp-action="Take" asp-route-id="@quiz.Id" class="btn btn-sm btn-primary">Start Quiz</a>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Enroll to take this quiz</span>
                                        }
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p class="text-muted">No quizzes have been added for this course yet.</p>
                        }
                    </div>

                    <!-- ===== Reviews ===== -->
                    <div class="tab-pane fade" id="tab-reviews" role="tabpanel">
                        <div class="row g-4 mb-4">
                            <div class="col-md-4 text-center border-end">
                                <div class="display-4 fw-bold text-primary">@avgRating.ToString("0.0")</div>
                                <div class="mb-1">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <i class="fa fa-star @(i <= Math.Round(avgRating) ? "text-warning" : "text-muted")"></i>
                                    }
                                </div>
                                <div class="text-muted small">@reviewCount review@(reviewCount == 1 ? "" : "s")</div>
                            </div>
                            <div class="col-md-8">
                                @for (int star = 5; star >= 1; star--)
                                {
                                    int count = ratingDistribution.TryGetValue(star, out int c) ? c : 0;
                                    int percent = reviewCount > 0 ? (int)Math.Round(count * 100.0 / reviewCount) : 0;
                                    <div class="d-flex align-items-center mb-2">
                                        <span class="me-2" style="width:45px;">@star star</span>
                                        <div class="rating-bar flex-grow-1 me-2">
                                            <div class="rating-bar-fill" style="width:@(percent)%;"></div>
                                        </div>
                                        <span class="text-muted small" style="width:30px;">@count</span>
                                    </div>
                                }
                            </div>
                        </div>

                        @if (User.Identity != null && User.Identity.IsAuthenticated && isEnrolled)
                        {
                            <form asp-controller="Review" asp-action="Create" method="post" class="bg-light rounded p-4 mb-4">
                                <input type="hidden" name="courseId" value="@Model.Id" />
                                <label class="form-label fw-bold">@(hasReviewed ? "Update your review" : "Leave a review")</label>
                                <div class="mb-3">
                                    <select name="rating" class="form-select" style="max-width:160px;">
                                        <option value="5">5 - Excellent</option>
                                        <option value="4">4 - Good</option>
                                        <option value="3">3 - Average</option>
                                        <option value="2">2 - Below Average</option>
                                        <option value="1">1 - Poor</option>
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <textarea name="comment" class="form-control" rows="3" placeholder="Share your thoughts about this course (optional)"></textarea>
                                </div>
                                <button type="submit" class="btn btn-primary">Submit Review</button>
                            </form>
                        }
                        else if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <p class="text-muted">Enroll in this course to leave a review.</p>
                        }

                        @if (reviews != null && reviews.Any())
                        {
                            <div class="d-flex flex-column gap-3">
                                @foreach (var review in reviews)
                                {
                                    <div class="border rounded p-3">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <strong>@review.Student?.Name @review.Student?.Surname</strong>
                                            <span class="text-muted small">@review.CreatedDate.ToString("dd.MM.yyyy")</span>
                                        </div>
                                        <div class="mb-2">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                <i class="fa fa-star @(i <= review.Rating ? "text-warning" : "text-muted")"></i>
                                            }
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(review.Comment))
                                        {
                                            <p class="mb-0">@review.Comment</p>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-muted">No reviews yet. Be the first to share your experience!</p>
                        }
                    </div>

                    <!-- ===== Instructor ===== -->
                    <div class="tab-pane fade" id="tab-instructor" role="tabpanel">
                        @if (Model.Teacher != null)
                        {
                            var teacher = Model.Teacher;
                            <div class="d-flex flex-column flex-sm-row gap-4">
                                <img class="rounded-circle" style="width:120px;height:120px;object-fit:cover;" src="@Url.Content(LMS.Utilites.TeacherPhotoHelper.GetDisplayPhotoUrl(teacher.Id, teacher.PhotoUrl))" alt="@teacher.FullName" onerror="this.onerror=null;this.src='@Url.Content("~/img/team-1.jpg")'">
                                <div>
                                    <h5 class="mb-1">@teacher.FullName</h5>
                                    <p class="text-muted mb-2">@teacher.Subject</p>
                                    <p class="mb-3">@teacher.Bio</p>
                                    <div class="d-flex gap-4 mb-3">
                                        <div><strong>@ViewBag.TeacherCourseCount</strong><div class="text-muted small">Courses</div></div>
                                        <div><strong>@ViewBag.TeacherStudentCount</strong><div class="text-muted small">Students</div></div>
                                    </div>
                                    <a asp-controller="Teacher" asp-action="Details" asp-route-id="@teacher.Id" class="btn btn-primary btn-sm">View Profile</a>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="d-flex align-items-center gap-3">
                                <i class="fa fa-user-tie fa-3x text-primary"></i>
                                <div>
                                    <h5 class="mb-1">@Model.InstructorName</h5>
                                    <p class="text-muted mb-0">Instructor details are not available for this course yet.</p>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="details-sidebar-sticky bg-white p-4">
                    <p class="mb-2"><i class="fa fa-user-tie text-primary me-2"></i><strong>Instructor:</strong> @(Model.Teacher?.FullName ?? Model.InstructorName)</p>
                    @if (Model.TeacherId != null)
                    {
                        <p class="mb-2"><a asp-controller="Teacher" asp-action="Details" asp-route-id="@Model.TeacherId" class="text-decoration-none"><i class="fa fa-id-badge text-primary me-2"></i>View teacher profile & reviews</a></p>
                    }
                    <p class="mb-2"><i class="fa fa-layer-group text-primary me-2"></i><strong>Category:</strong> @Model.Category?.Name</p>
                    <p class="mb-4"><i class="fa fa-user-graduate text-primary me-2"></i><strong>Students:</strong> @studentCount enrolled</p>

                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        if (isEnrolled)
                        {
                            <button class="btn btn-success w-100 mb-4" disabled><i class="fa fa-check me-2"></i>You are enrolled</button>
                        }
                        else
                        {
                            <form asp-controller="Course" asp-action="Enroll" method="post" class="mb-4">
                                <input type="hidden" name="courseId" value="@Model.Id" />
                                <button type="submit" class="btn btn-primary w-100 py-3">Enroll in Course</button>
                            </form>
                        }
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn btn-primary w-100 py-3 mb-4">Log in to enroll</a>
                    }

                    <hr />

                    <h6 class="mb-3">This Course Includes</h6>
                    <ul class="list-unstyled course-includes-list mb-0">
                        <li><i class="fa fa-book-open text-primary me-2"></i>@activeLessons.Count lesson@(activeLessons.Count == 1 ? "" : "s")</li>
                        <li><i class="fa fa-clock text-primary me-2"></i>@Model.DurationHours hours total duration</li>
                        <li><i class="fa fa-question-circle text-primary me-2"></i>@activeQuizzes.Count quiz@(activeQuizzes.Count == 1 ? "" : "zes")</li>
                        <li><i class="fa fa-certificate text-primary me-2"></i>Certificate of completion</li>
                        <li><i class="fa fa-infinity text-primary me-2"></i>Lifetime access</li>
                        <li><i class="fa fa-mobile-screen text-primary me-2"></i>Mobile friendly</li>
                    </ul>
                </div>
            </div>
        </div>

        @if (relatedCourses != null && relatedCourses.Any())
        {
            <div class="mt-5">
                <h4 class="mb-4">Related Courses</h4>
                <div class="row g-4">
                    @foreach (var related in relatedCourses)
                    {
                        <div class="col-md-3 col-sm-6">
                            <a asp-controller="Course" asp-action="Details" asp-route-id="@related.Id" class="text-decoration-none text-dark">
                                <div class="related-course-card bg-white shadow-sm rounded h-100">
                                    <img class="img-fluid w-100 rounded-top" style="height:140px;object-fit:cover;" src="@(string.IsNullOrEmpty(related.ImageUrl) ? Url.Content($"~/img/course-{(related.Id % 3) + 1}.jpg") : Url.Content("~/uploads/courses/" + related.ImageUrl))" alt="@related.Name" onerror="this.onerror=null;this.src='@Url.Content("~/img/course-2.jpg")'">
                                    <div class="p-3">
                                        <span class="badge bg-light text-dark border small mb-2">@related.Category?.Name</span>
                                        <h6 class="mb-1">@related.Name</h6>
                                        <span class="text-muted small"><i class="fa fa-signal me-1"></i>@related.Level</span>
                                    </div>
                                </div>
                            </a>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/lessonProgress.js"></script>
}
